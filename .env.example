# Copy this file to .env, then adjust as needed.
#
#   copy .env.example .env
#
# If .env is absent, docker-compose still starts (the env_file entry is marked
# optional) and the serving container falls back to the placeholder model.
#
# The sections below marked "Google Cloud deployment" are read by
# scripts/deploy_gcp.sh and scripts/teardown_gcp.sh; put your own project id and
# bucket there (never commit .env - it is gitignored).

# ---------------------------------------------------------------------------
# Google Cloud deployment (read by scripts/*.sh; keep .env out of git)
# ---------------------------------------------------------------------------
# GCP_PROJECT=your-project-id
# GCP_REGION=australia-southeast1
# GCP_ZONE=australia-southeast1-a
# GCP_BUCKET=your-recsys-bucket
# GCP_AR_REPO=gpu-recsys
# GKE_CLUSTER=gpu-recsys
# GKE_MACHINE_TYPE=e2-standard-2
# GKE_DISK_SIZE=30
#
# Deploy:  bash scripts/deploy_gcp.sh      (uses .env, or PROJECT=/BUCKET= inline)
# Teardown: bash scripts/teardown_gcp.sh

# Bucket holding the trained artefacts (the object names live in the code).
MODEL_BUCKET=gpu-recsys

# Point the Google Cloud client at the local emulator.
# The http:// scheme is REQUIRED -- without it the client builds a URL like
# "gcs:4443/storage/v1/..." and fails with a confusing
# "No connection adapters were found" error.
# docker-compose sets this automatically for the ingest, jupyter and serving
# services; it is listed here for host processes and notebook use.
# Leave it OUT when deploying to GKE so the real Google credentials are used.
STORAGE_EMULATOR_HOST=http://gcs:4443

# Override the GPU table path if you mount the data elsewhere.
GPUS_CSV=/app/data/gpus.csv

# ---------------------------------------------------------------------------
# Dataset provenance (Zenodo)
# ---------------------------------------------------------------------------
# Pinned version record. Every file's MD5 is published by the archive and is
# checked by the ingest script, so a run is byte-identical and verifiable.
ZENODO_RECORD_ID=23162309

# Concept record -- represents ALL versions and always resolves to the newest:
#   https://zenodo.org/records/23162308   (DOI 10.5281/zenodo.23162308)
# Use it via:  docker compose run --rm ingest --latest
#
# Cite the version DOI for reproducibility:
#   PCGameBenchmarks. (2026). PC Game System Requirements & Estimated FPS by
#   GPU (Version 2026-10-03) [Dataset]. Zenodo.
#   https://doi.org/10.5281/zenodo.23162309
# Licensed CC BY 4.0 -- attribution is required.
